#########################
# ofxOnnxRuntime
#########################

# NOTE: this file used to be a verbatim copy of the openFrameworks *core*
# .gitignore. Those rules are written for an OF root checkout, and two of
# them quietly broke this addon:
#
#   /libs/*      -- meant to drop OF's downloaded core libs, but here it
#                   matched libs/onnxruntime/lib/**, i.e. the prebuilt ONNX
#                   Runtime binaries that ARE this addon's payload, plus any
#                   header added after the rule landed.
#   addons/*, apps/*, libs/openFrameworksCompiled/*
#                -- paths that only exist in an OF root, never in an addon.
#
# So: no blanket /libs/* rule here. libs/onnxruntime/{include,lib} is tracked
# on purpose; that is what a fresh clone links against.

# Build output. The example's bin/ is repopulated on every build: openFrameworks'
# copyaddonslibs step copies libs/onnxruntime/lib/<platform>/ into it, so the
# runtime libraries and the executable must not be committed from there.
# (the ** prefix matters: a pattern with an interior '/' is anchored to
# this file's directory, so a bare 'bin/*' would only match a bin/ at the
# repo root and miss example-onnx_mnist/bin/.)
[Oo]bj/
**/[Bb]in/*
!**/[Bb]in/data

# Upstream release archive and packaging metadata that ship inside the
# onnxruntime tarball. The .pc/cmake files hardcode a /usr/local + lib64
# prefix and are meaningless to an openFrameworks build.
libs/onnxruntime/lib/**/*.tgz
libs/onnxruntime/lib/**/cmake/
libs/onnxruntime/lib/**/pkgconfig/

#########################
# general
#########################

*.o
*.obj
[Bb]uild/
*.log
packages/

#########################
# IDE
#########################

# XCode
*.pbxuser
*.perspective
*.perspectivev3
*.mode1v3
*.mode2v3
xcuserdata
*.xcworkspace

# Visual Studio
*.sdf
*.opensdf
*.suo
*.pdb
*.ilk
*.aps
ipch/
.vs/

# QtCreator
*.qbs.user
*.pro.user
*.pri

#########################
# operating system
#########################

# Linux
*~
.directory

# OSX
.DS_Store
*.swp
._*

# Windows
Thumbs.db
Desktop.ini
